# Lisa Environment Variables
# Copy this to .env and fill in your values

# ===================
# Database
# ===================
DATABASE_URL=postgresql+asyncpg://lisa:your_password@localhost:5432/lisa

# ===================
# Redis
# ===================
REDIS_URL=redis://localhost:6379/0

# ===================
# Security
# ===================
# Generate with: openssl rand -hex 32
SECRET_KEY=your-secret-key-here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ===================
# CORS
# ===================
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ===================
# App Settings
# ===================
DEBUG=true
APP_NAME=Lisa
APP_VERSION=0.1.0

# ===================
# Email (SendGrid)
# ===================
SENDGRID_API_KEY=
EMAIL_FROM=noreply@yourdomain.com

# ===================
# File Storage (S3)
# ===================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=lisa-uploads

# ===================
# Integrations
# ===================

# QuickBooks
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_REDIRECT_URI=http://localhost:8000/api/v1/integrations/quickbooks/callback

# EagleView
EAGLEVIEW_API_KEY=
EAGLEVIEW_API_SECRET=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ===================
# Frontend
# ===================
VITE_API_URL=http://localhost:8000/api/v1
